<!doctype html>
{% assign page_lang = page.lang | default: 'zh' %}
<html lang="{% if page_lang == 'en' %}en{% else %}zh-CN{% endif %}">
  <!-- Head -->
  <head>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}
    <link rel="stylesheet" href="{{ '/assets/css/inline-editor.css' | relative_url }}">

    {% assign translation_pool = site.pages
      | concat: site.projects
      | concat: site.posts
      | concat: site.news
      | concat: site.teachings
      | concat: site.books
    %}
    {% assign translated_pages = translation_pool | where: 'translation_key', page.translation_key %}
    {% for translated_page in translated_pages %}
      <link
        rel="alternate"
        hreflang="{% if translated_page.lang == 'en' %}en{% else %}zh-CN{% endif %}"
        href="{{ translated_page.url | absolute_url }}"
      >
    {% endfor %}
    {% assign default_translation = translated_pages | where: 'lang', 'zh' | first %}
    {% if default_translation %}
      <link rel="alternate" hreflang="x-default" href="{{ default_translation.url | absolute_url }}">
    {% endif %}
  </head>

  <!-- Body -->
  <body
    class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}"
    data-page-language="{{ page_lang }}"
  >
    <!-- Header -->
    {% include header.liquid %}

    <!-- Content -->
    <div class="container mt-5" role="main">
      {% if page.path %}
        {% include inline-editor.liquid %}
      {% endif %}
      <div id="site-rendered-content">
        {% if page.toc and page.toc.sidebar %}
          {% assign toc_collapse = page.toc.collapse | default: 'expanded' %}
          {% assign toc_collapse_depth = page.toc.collapse_depth | default: '' %}
          {% if page.toc.sidebar == 'right' %}
            <div class="row">
              <div class="col-sm-9">{{ content }}</div>
              <div class="col-sm-3">
                <nav
                  id="toc-sidebar"
                  class="sticky-top toc toc-sidebar"
                  aria-label="Table of contents"
                  data-toc-collapse="{{ toc_collapse }}"
                  data-toc-collapse-depth="{{ toc_collapse_depth }}"
                ></nav>
              </div>
            </div>
          {% else %}
            <div class="row">
              <div class="col-sm-3">
                <nav
                  id="toc-sidebar"
                  class="sticky-top toc toc-sidebar"
                  aria-label="Table of contents"
                  data-toc-collapse="{{ toc_collapse }}"
                  data-toc-collapse-depth="{{ toc_collapse_depth }}"
                ></nav>
              </div>
              <div class="col-sm-9">{{ content }}</div>
            </div>
          {% endif %}
        {% else %}
          {{ content }}
        {% endif %}
      </div>
    </div>

    <!-- Footer -->
    {% include footer.liquid %}

    <!-- JavaScripts -->
    {% include scripts.liquid %}
    <script src="{{ '/assets/js/inline-editor.js' | relative_url }}"></script>
  </body>
</html>
