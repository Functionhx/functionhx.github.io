<!doctype html>
{% assign page_lang = page.lang | default: 'zh' %}
{% assign spark_writer_enabled = false %}
{% if page_lang != 'en' and page.translation_key == 'spark' %}
  {% assign spark_writer_enabled = true %}
{% elsif page.path contains '_posts/' %}
  {% if page_lang != 'en' %}
    {% if page.kind == 'note' or page.kind == 'log' %}
      {% assign spark_writer_enabled = true %}
    {% endif %}
  {% endif %}
{% endif %}
{% assign editor_source_path = page.path %}
{% unless editor_source_path contains '_' %}
  {% assign editor_source_stem = page.settings_file_stem | default: page.translation_key %}
  {% if editor_source_stem %}
    {% capture editor_source_path %}_pages/{{ editor_source_stem }}-{{ page_lang }}.md{% endcapture %}
  {% endif %}
{% endunless %}
<html
  lang="{% if page_lang == 'en' %}en{% else %}zh-CN{% endif %}"
  data-nav-density="{{ site.data.site_ui.navigation_density | default: 'auto' | escape }}"
>
  <!-- Head -->
  <head>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}
    {% include site-preferences.liquid %}
    {% include owner-ui.liquid %}
    {% if page.home %}
      <link rel="stylesheet" href="{{ '/assets/css/home.css' | relative_url | bust_file_cache }}">
    {% endif %}
    {% if spark_writer_enabled %}
      <link rel="stylesheet" href="{{ '/assets/css/spark-writer.css' | relative_url }}">
    {% endif %}
    {% if page.video %}
      <link rel="stylesheet" href="{{ '/assets/css/media-embeds.css' | relative_url | bust_file_cache }}">
    {% endif %}
    <style>
      @view-transition {
        navigation: auto;
      }

      #navbar {
        view-transition-name: site-navbar;
      }

      #site-rendered-content {
        view-transition-name: site-content;
      }

      ::view-transition-group(root),
      ::view-transition-group(site-navbar),
      ::view-transition-group(site-content) {
        animation-duration: 160ms;
        animation-timing-function: ease-out;
      }

      @media (prefers-reduced-motion: reduce) {
        ::view-transition-group(root),
        ::view-transition-group(site-navbar),
        ::view-transition-group(site-content) {
          animation-duration: 0.01ms;
        }
      }
    </style>

    {% assign translation_pool = site.pages
      | concat: site.projects
      | concat: site.posts
      | concat: site.news
      | concat: site.teachings
      | concat: site.books
    %}
    {% assign translated_pages = translation_pool | where: 'translation_key', page.translation_key %}
    {% for translated_page in translated_pages %}
      <link
        rel="alternate"
        hreflang="{% if translated_page.lang == 'en' %}en{% else %}zh-CN{% endif %}"
        href="{{ translated_page.url | absolute_url }}"
      >
    {% endfor %}
    {% assign default_translation = translated_pages | where: 'lang', 'zh' | first %}
    {% if default_translation %}
      <link rel="alternate" hreflang="x-default" href="{{ default_translation.url | absolute_url }}">
    {% endif %}
  </head>

  <!-- Body -->
  <body
    class="{% if site.navbar_fixed %}fixed-top-nav{% endif %}"
    data-page-language="{{ page_lang }}"
  >
    <div id="site-page-loader" class="site-page-loader" role="status" aria-live="polite">
      <span class="site-page-loader__text" aria-hidden="true"></span>
      <span class="sr-only">Thinking...</span>
    </div>
    <!-- Header -->
    {% include header.liquid %}
    {% include site-settings.liquid %}
    {% include deepseek-translator.liquid %}
    {% include deployment-monitor.liquid %}

    <!-- Content -->
    <div class="container mt-5" role="main">
      {% if editor_source_path and page_lang != 'en' %}
        {% include inline-editor.liquid source_path=editor_source_path %}
        {% include content-creator.liquid %}
      {% endif %}
      <div id="site-rendered-content">
        {% if page.toc and page.toc.sidebar %}
          {% assign toc_collapse = page.toc.collapse | default: 'expanded' %}
          {% assign toc_collapse_depth = page.toc.collapse_depth | default: '' %}
          {% if page.toc.sidebar == 'right' %}
            <div class="row">
              <div class="col-sm-9">{{ content }}</div>
              <div class="col-sm-3">
                <nav
                  id="toc-sidebar"
                  class="sticky-top toc toc-sidebar"
                  aria-label="Table of contents"
                  data-toc-collapse="{{ toc_collapse }}"
                  data-toc-collapse-depth="{{ toc_collapse_depth }}"
                ></nav>
              </div>
            </div>
          {% else %}
            <div class="row">
              <div class="col-sm-3">
                <nav
                  id="toc-sidebar"
                  class="sticky-top toc toc-sidebar"
                  aria-label="Table of contents"
                  data-toc-collapse="{{ toc_collapse }}"
                  data-toc-collapse-depth="{{ toc_collapse_depth }}"
                ></nav>
              </div>
              <div class="col-sm-9">{{ content }}</div>
            </div>
          {% endif %}
        {% else %}
          {{ content }}
        {% endif %}
      </div>
    </div>

    <!-- JavaScripts -->
    <script src="{{ '/assets/js/site-preferences.js' | relative_url | bust_file_cache }}"></script>
    <script src="{{ '/assets/js/owner-ui.js' | relative_url | bust_file_cache }}"></script>
    {% include scripts.liquid %}
    {% if page.home %}
      <script src="{{ '/assets/js/home-contact.js' | relative_url | bust_file_cache }}"></script>
    {% endif %}
    <script src="{{ '/assets/js/navigation-performance.js' | relative_url | bust_file_cache }}"></script>
    <script src="{{ '/assets/js/admin-loader.js' | relative_url | bust_file_cache }}"></script>
  </body>
</html>
