---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if page.lang == 'zh' %}
        <span class="font-weight-bold">樊宇琛</span>
      {% elsif site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3 }}px, (min-width: 576px) 30vw, 95vw{% endcapture %}
          {% if page.profile.image_srcset_webp %}
            {% assign profile_image_small = page.profile.image_srcset_webp.small | prepend: 'assets/img/' %}
            {% assign profile_image_large = page.profile.image_srcset_webp.large | prepend: 'assets/img/' %}
            <figure>
              <picture>
                <source
                  srcset="{{ profile_image_small | relative_url | bust_file_cache }} 480w, {{ profile_image_large | relative_url | bust_file_cache }} 800w"
                  sizes="{{ sizes | strip }}"
                  type="image/webp"
                >
                <img
                  src="{{ profile_image_path | relative_url | bust_file_cache }}"
                  class="{{ profile_image_class }}"
                  width="{{ page.profile.image_width | default: 800 }}"
                  height="{{ page.profile.image_height | default: 1067 }}"
                  alt="{{ page.profile.image_alt | default: page.profile.image }}"
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                >
              </picture>
            </figure>
          {% else %}
            {%
              include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
              cache_bust=true
            %}
          {% endif %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ page.news_path | default: '/news/' | relative_url }}" style="color: inherit">
          {{- page.labels.news | default: 'news' -}}
        </a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ page.writing_path | default: '/writing/' | relative_url }}" style="color: inherit">
          {{- page.labels.latest_posts | default: 'latest posts' -}}
        </a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    {% if page.selected_papers %}
      <h2>
        <a href="{{ page.research_path | default: '/research/' | relative_url }}" style="color: inherit">
          {{- page.labels.selected_publications | default: 'selected publications' -}}
        </a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>
        <div class="contact-note">{{ page.contact_note | default: site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% if site.plugins contains 'al_newsletter' %}
        {% include plugins/al_newsletter_form_center_margin.liquid %}
      {% else %}
        {% include newsletter.liquid center=true %}
      {% endif %}
    {% endif %}
  </article>
</div>
