# ALLOWED_FEISHU_TENANT_KEY=REPLACE_WITH_OWNER_TENANT_KEY
# FEISHU_FOLDER_TOKEN=fld_REPLACE_WITH_TARGET_FOLDER_TOKEN
SESSION_KEY_B64=REPLACE_ON_SERVER
MASTER_KEY_B64=REPLACE_ON_SERVER_AND_BACK_UP_OFFLINE
