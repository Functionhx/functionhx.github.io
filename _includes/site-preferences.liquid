<script>
  (() => {
    const root = document.documentElement;
    const supportedFonts = new Set(['anthropic-serif', 'anthropic-sans', 'system', 'dyslexic']);
    const supportedLoadingCopy = new Set(['thinking', 'loading', 'thinking-zh', 'loading-zh']);
    const supportedSeasonEffects = new Set(['off', 'auto', 'snow', 'sakura', 'rain', 'leaves']);
    root.classList.add('js');
    const loaderState = window.functionhxPageLoaderState || { hideTimer: 0, showTimer: 0, visibleAt: 0 };
    window.functionhxPageLoaderState = loaderState;
    loaderState.showTimer = window.setTimeout(() => {
      root.dataset.pageLoading = 'true';
      loaderState.showTimer = 0;
      loaderState.visibleAt = performance.now();
    }, 180);
    // 字体与加载文案由站长在设置面板发布到 _data/site_ui.yml，对所有访客生效。
    const publishedFont = {{ site.data.site_ui.site_font | default: 'system' | jsonify }};
    const publishedLoadingCopy = {{ site.data.site_ui.loading_copy | default: 'thinking' | jsonify }};
    root.dataset.publishedSiteFont = supportedFonts.has(publishedFont) ? publishedFont : 'system';
    root.dataset.publishedLoadingCopy = supportedLoadingCopy.has(publishedLoadingCopy) ? publishedLoadingCopy : 'thinking';
    const publishedSeasonEffect = {{ site.data.site_ui.season_effect | default: 'off' | jsonify }};
    root.dataset.publishedSeasonEffect = supportedSeasonEffects.has(publishedSeasonEffect) ? publishedSeasonEffect : 'off';
    root.dataset.siteFont = root.dataset.publishedSiteFont;
    root.dataset.loadingCopy = root.dataset.publishedLoadingCopy;
    try {
      root.dataset.turbo = window.localStorage.getItem('functionhx:turbo-mode') === 'on' ? 'on' : 'off';
    } catch (_error) {
      root.dataset.turbo = 'off';
    }
  })();
</script>
<link rel="stylesheet" href="{{ '/assets/css/site-preferences.css' | relative_url | bust_file_cache }}">
