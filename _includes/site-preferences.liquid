<script>
  (() => {
    const root = document.documentElement;
    const supportedFonts = new Set(['anthropic-serif', 'anthropic-sans', 'system', 'dyslexic']);
    const supportedLoadingCopy = new Set(['thinking', 'loading', 'thinking-zh', 'loading-zh']);
    root.classList.add('js');
    root.dataset.pageLoading = 'true';
    try {
      const savedFont = window.localStorage.getItem('functionhx:site-font');
      const savedLoadingCopy = window.localStorage.getItem('functionhx:loading-copy');
      root.dataset.siteFont = supportedFonts.has(savedFont) ? savedFont : 'system';
      root.dataset.loadingCopy = supportedLoadingCopy.has(savedLoadingCopy) ? savedLoadingCopy : 'thinking';
    } catch (_error) {
      root.dataset.siteFont = 'system';
      root.dataset.loadingCopy = 'thinking';
    }
  })();
</script>
<link rel="stylesheet" href="{{ '/assets/css/site-preferences.css' | relative_url | bust_file_cache }}">
