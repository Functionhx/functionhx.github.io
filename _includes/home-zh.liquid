{% assign github_user = 'Functionhx' %}
<div class="function-home">
  <section class="function-intro" aria-labelledby="function-name">
    <div class="function-intro-copy">
      <figure class="function-portrait">
        <img
          src="{{ '/assets/img/function/portrait-hero-v2-960.webp' | relative_url | bust_file_cache }}"
          srcset="{{ '/assets/img/function/portrait-hero-v2-960.webp' | relative_url | bust_file_cache }} 960w, {{ '/assets/img/function/portrait-hero-v2-1760.webp' | relative_url | bust_file_cache }} 1760w"
          sizes="480px"
          width="1760"
          height="880"
          alt="根据樊宇琛本人照片绘制的动漫风插画肖像"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        >
        <figcaption class="sr-only">插画肖像</figcaption>
      </figure>
      <p class="function-intro-alias" lang="en">Function</p>
      <h1 id="function-name">樊宇琛<span lang="en">Yuchen Fan</span></h1>
      <section class="function-introduction" id="introduction" aria-label="关于我">{{ content }}</section>
      <div class="function-contact-links">
        <a class="function-button function-button--github" href="https://github.com/{{ github_user }}">
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38v-1.34c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.72 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8"/>
          </svg>
          在 GitHub 上看看
          <span class="function-button-note">@{{ github_user }}</span>
        </a>
        <a class="function-text-link" href="#contact">联系我 <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <nav class="function-directory" aria-labelledby="function-directory-heading">
      <p class="function-directory-heading" id="function-directory-heading">浏览本站</p>
      {% for entry in site.data.home.directory %}
        <a href="{{ entry.url | relative_url }}" class="function-directory-link"
          ><span class="function-directory-title">{{ entry.title }}</span><span class="function-directory-note">{{ entry.note }}</span
          ><span class="function-directory-arrow" aria-hidden="true">→</span></a
        >
      {% endfor %}
    </nav>
  </section>
  {% if page.announcements.enabled %}
    {% assign updates = site.news | concat: site.posts | where: 'lang', 'zh' | sort: 'date' | reverse %}
    {% assign update_count = 0 %}
    <section class="function-timeline" aria-labelledby="updates-heading">
      <div class="function-timeline-heading">
        <h2 id="updates-heading">最近的更新</h2>
        <a href="{{ '/news/' | relative_url }}">全部动态 <span aria-hidden="true">↗</span></a>
      </div>
      <ol class="function-events">
        {% for item in updates %}
          {% assign show_update = false %}
          {% if item.path contains '_news/' or item.announce == true %}{% assign show_update = true %}{% endif %}
          {% if item.published == false or item.private == true or item.visibility == 'private' %}{% assign show_update = false %}{% endif %}
          {% if show_update and update_count < page.announcements.limit %}
            {% assign update_count = update_count | plus: 1 %}
            {% assign summary = site.data.home.updates[item.translation_key] %}
            <li class="function-event">
              <h3>
                <a href="{{ summary.url | default: item.url | relative_url }}">
                  {{- summary.title | default: item.title -}}
                </a>
              </h3>
              {% assign update_description = summary.description | default: item.description %}
              {% if update_description and update_description != empty %}
                <p class="function-event-description">{{ update_description | escape }}</p>
              {% endif %}
              <time datetime="{{ item.date | date: '%Y-%m-%d' }}">{{ item.date | date: '%Y 年 %-m 月 %-d 日' }}</time>
              {% if item.path contains '_news/' %}
                <button
                  type="button"
                  class="activity-feed__edit owner-only-control"
                  data-owner-context-control
                  data-author-action="source-edit"
                  data-source-path="{{ item.path | escape }}"
                  title="编辑动态：{{ item.title | escape }}"
                  aria-label="编辑动态：{{ item.title | escape }}"
                  hidden
                >
                  <i class="fa-regular fa-pen-to-square" aria-hidden="true"></i>
                </button>
              {% endif %}
            </li>
          {% endif %}
        {% endfor %}
      </ol>
    </section>
  {% endif %}
  <div class="function-reading">
    {% include contrail-card.liquid %}
    {% include training-card.liquid %}
    {% if page.social %}
      <section class="social" id="contact" aria-labelledby="contact-heading">
        <h2 id="contact-heading">联系我</h2>
        <p class="contact-note">{{ page.contact_note }}</p>
        <div class="contact-icons">{% social_links %}</div>
        <p id="contact-copy-status" class="contact-copy-status" role="status" aria-live="polite" aria-atomic="true"></p>
      </section>
      <dialog id="wechat-qr-dialog" class="wechat-qr-dialog" aria-labelledby="wechat-qr-heading" aria-describedby="wechat-qr-description">
        <form method="dialog">
          <button class="wechat-qr-dialog__close" value="close" aria-label="关闭微信二维码"><span aria-hidden="true">×</span></button>
        </form>
        <div class="wechat-qr-dialog__body">
          <h2 id="wechat-qr-heading">微信</h2>
          <img
            src="{{ '/assets/img/social/wechat-qr.png' | relative_url | bust_file_cache }}"
            width="660"
            height="660"
            alt="樊宇琛的微信二维码"
            loading="lazy"
            decoding="async"
          >
          <p id="wechat-qr-description">扫码添加我为好友。</p>
        </div>
      </dialog>
    {% endif %}
    <div class="function-colophon">
      <span>樊宇琛的个人主页</span
      ><span class="function-colophon-links"
        ><a href="https://github.com/{{ github_user }}">GitHub <span aria-hidden="true">↗</span></a
        ><a href="https://github.com/Functionhx/magic-site-blueprint">本站源码 <span aria-hidden="true">↗</span></a></span
      ><a href="#top">回到顶部 <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</div>
