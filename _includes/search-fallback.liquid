{% assign search_lang = include.lang | default: page.lang | default: 'zh' %}
{% if search_lang == 'en' %}
  {% assign search_button = 'Open Magic Search' %}
  {% assign search_help = 'Search published content in visible sections. Hidden sections are available in owner search after verification.' %}
  {% assign fallback_heading = 'Browse visible public content' %}
{% else %}
  {% assign search_button = '打开 Magic Search' %}
  {% assign search_help = '检索首页与已显示栏目的公开内容；验证站长身份后，可额外检索隐藏栏目。' %}
  {% assign fallback_heading = '浏览公开栏目' %}
{% endif %}

<div class="magic-search-fallback" data-magic-search-autostart>
  <p>{{ search_help }}</p>
  <p>
    <button class="btn btn-outline-primary" type="button" data-magic-search-open>{{ search_button }}</button>
  </p>
</div>

<noscript>
  <section aria-labelledby="search-fallback-heading">
    <h2 id="search-fallback-heading">{{ fallback_heading }}</h2>

    {% assign fallback_documents = site.data.public_search_documents[search_lang] | group_by: 'section' %}
    {% for section in fallback_documents %}
      <h3>{{ section.name | escape }}</h3>
      <ul>
        {% for item in section.items %}
          <li>
            <a href="{{ item.url | relative_url }}">{{ item.title | escape }}</a>
            {% if item.description != empty %}— {{ item.description | escape }}{% endif %}
          </li>
        {% endfor %}
      </ul>
    {% endfor %}
  </section>
</noscript>
