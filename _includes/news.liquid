{% assign current_lang = page.lang | default: 'zh' %}
{% assign localized_news = site.news | where: 'lang', current_lang %}
<div class="news">
  {% if localized_news != blank %}
    {% assign news_size = localized_news | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = localized_news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%Y-%m-%d' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
              {% if current_lang != 'en' %}
                <button
                  type="button"
                  class="activity-feed__edit owner-only-control"
                  data-author-action="source-edit"
                  data-source-path="{{ item.path | escape }}"
                  title="编辑动态：{{ item.title | escape }}"
                  aria-label="编辑动态：{{ item.title | escape }}"
                >
                  <i class="fa-regular fa-pen-to-square" aria-hidden="true"></i>
                </button>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% elsif current_lang == 'en' %}
    <p>No updates yet.</p>
  {% else %}
    <p>暂无动态。</p>
  {% endif %}
</div>
