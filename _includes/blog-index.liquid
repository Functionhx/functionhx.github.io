{% assign current_lang = page.lang | default: 'zh' %}
{% if current_lang == 'en' %}
  {% assign read_label = 'min read' %}
  {% assign empty_label = 'No public writing yet.' %}
  {% assign external_label = 'Open external article' %}
{% else %}
  {% assign read_label = '分钟阅读' %}
  {% assign empty_label = '暂时还没有公开文章。' %}
  {% assign external_label = '打开外部文章' %}
{% endif %}

<div class="post">
  <header class="header-bar">
    <h1>{{ page.blog_name }}</h1>
    <h2>{{ page.blog_description }}</h2>
  </header>

  {% assign postlist = paginator.posts | where: 'lang', current_lang %}
  {% if postlist.size > 0 %}
    <ul class="post-list">
      {% for post in postlist %}
        {% assign read_time = post.content | number_of_words | divided_by: 180 | plus: 1 %}
        <li>
          <h3>
            {% if post.redirect == blank %}
              <a class="post-title" href="{{ post.url | relative_url }}">{{ post.title }}</a>
            {% elsif post.redirect contains '://' %}
              <a class="post-title" href="{{ post.redirect }}" target="_blank" rel="noopener noreferrer">
                {{- post.title -}}
                <span class="sr-only">（{{ external_label }}）</span>
                <span aria-hidden="true"> ↗</span>
              </a>
            {% else %}
              <a class="post-title" href="{{ post.redirect | relative_url }}">{{ post.title }}</a>
            {% endif %}
          </h3>

          <p>{{ post.description }}</p>

          <p class="post-meta">
            <time datetime="{{ post.date | date_to_xmlschema }}">
              {% if current_lang == 'en' %}
                {{ post.date | date: '%B %d, %Y' }}
              {% else %}
                {{ post.date | date: '%Y.%m.%d' }}
              {% endif %}
            </time>
            &nbsp;·&nbsp; {{ read_time }}
            {{ read_label }}
            {% if post.external_source %}
              &nbsp;·&nbsp; {{ post.external_source }}
            {% endif %}
          </p>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="post-meta">{{ empty_label }}</p>
  {% endif %}

  {% include pagination.liquid %}
</div>
