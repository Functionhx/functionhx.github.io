{% if page.lang == 'zh' %}
  {% assign stats_locale = 'cn' %}
{% else %}
  {% assign stats_locale = 'en' %}
{% endif %}
{% assign stats_url = site.external_services.github_readme_stats_url | default: 'https://github-stats-extended.vercel.app' %}

<div class="repo p-2 text-center">
  <a href="https://github.com/{{ include.username }}">
    <img
      class="only-light w-100"
      alt="{{ include.username }}"
      src="{{ stats_url }}/api/?username={{ include.username }}&theme={{ site.repo_theme_light }}&locale={{ stats_locale }}&show_icons=true"
      data-hide-repo-on-error
    >
    <img
      class="only-dark w-100"
      alt="{{ include.username }}"
      src="{{ stats_url }}/api/?username={{ include.username }}&theme={{ site.repo_theme_dark }}&locale={{ stats_locale }}&show_icons=true"
      data-hide-repo-on-error
    >
  </a>
</div>
