{% assign repo_url = include.repository | split: '/' %}
{% if site.data.repositories.github_users contains repo_url.first %}
  {% assign show_owner = false %}
{% else %}
  {% assign show_owner = true %}
{% endif %}

{% if page.lang == 'zh' %}
  {% assign stats_locale = 'cn' %}
{% else %}
  {% assign stats_locale = 'en' %}
{% endif %}

{% if site.data.repositories.repo_description_lines_max %}
  {% assign max_lines = site.data.repositories.repo_description_lines_max %}
{% else %}
  {% assign max_lines = 2 %}
{% endif %}

{% assign stats_url = site.external_services.github_readme_stats_url | default: 'https://github-stats-extended.vercel.app' %}

<div class="repo p-2 text-center">
  <a href="https://github.com/{{ include.repository }}">
    <img
      class="only-light w-100"
      alt="{{ include.repository }}"
      src="{{ stats_url }}/api/pin/?username={{ repo_url[0] }}&repo={{ repo_url[1] }}&theme={{ site.repo_theme_light }}&locale={{ stats_locale }}&show_owner={{ show_owner }}&description_lines_count={{ max_lines }}"
      onerror="this.closest('.repo').style.display='none'"
    >
    <img
      class="only-dark w-100"
      alt="{{ include.repository }}"
      src="{{ stats_url }}/api/pin/?username={{ repo_url[0] }}&repo={{ repo_url[1] }}&theme={{ site.repo_theme_dark }}&locale={{ stats_locale }}&show_owner={{ show_owner }}&description_lines_count={{ max_lines }}"
      onerror="this.closest('.repo').style.display='none'"
    >
  </a>
</div>
