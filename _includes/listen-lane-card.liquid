{%- comment -%}
  栏目页卡片网格里的一张播客卡片，结构与 writing-card.liquid 一致（日期 · 标题 · 类型与时长），
  分类固定为「播客」，可被左侧筛选选中；指向 /notes/podcast/。
  用法：{% include listen-lane-card.liquid series='wealth-revolution' %}
{%- endcomment -%}
{% assign podcast = site.data.listen[include.series] %}
{% assign podcast_seconds = 0 %}
{% for episode in podcast.episodes %}
  {% assign podcast_seconds = podcast_seconds | plus: episode.seconds %}
{% endfor %}
{% assign card_cover = podcast.card_cover | default: podcast.cover %}
<article
  class="writing-card writing-card--podcast"
  data-category="播客"
  data-tags="|播客|{{ podcast.author | escape }}|"
  data-date="{{ podcast.added | date: '%Y-%m-%d' }}"
>
  <a class="writing-card-link" href="{{ '/notes/podcast/' | relative_url }}" title="{{ podcast.summary | escape }}">
    <div
      class="writing-card-art{% if podcast.card_cover %} writing-card-art--magazine{% endif %}"
      style="--writing-art: var(--function-art-sand)"
    >
      <img
        src="{{ card_cover | relative_url }}"
        alt="{% if podcast.card_cover %}{{ podcast.author }}登上《福布斯》封面{% endif %}"
        loading="lazy"
        decoding="async"
      >
    </div>
    <div class="writing-card-body">
      <time datetime="{{ podcast.added | date_to_xmlschema }}">{{ podcast.added | date: '%Y 年 %-m 月 %-d 日' }}</time>
      <h3>{{ podcast.author }}《{{ podcast.title | escape }}》</h3>
      {% if podcast.card_cover_credit -%}
        <span class="writing-card-credit">{{ podcast.card_cover_credit }}</span>
      {%- endif %}
      <p class="writing-card-meta">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M4 14v-2a8 8 0 0 1 16 0v2" /><path d="M4 14h3v6H4zM17 14h3v6h-3z" />
        </svg>
        <span>播客</span>
        <span aria-hidden="true">·</span>
        <span>{{ podcast.episodes.size }} 集 · 约 {{ podcast_seconds | divided_by: 3600 }} 小时</span>
      </p>
    </div>
  </a>
</article>
