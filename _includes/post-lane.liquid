{% assign current_lang = page.lang | default: 'zh' %}
{% assign localized_posts = site.posts | where: 'lang', current_lang %}
{% assign visible_post_count = 0 %}
{% if page.translation_key == 'spark' %}
  <div class="site-spark-toolbar">
    <div class="site-spark-toolbar__actions">
      <button id="site-spark-create" type="button" class="site-spark-create">
        <i class="fa-solid fa-plus" aria-hidden="true"></i>
        {% if current_lang == 'en' %}New Spark{% else %}新建闪耀{% endif %}
      </button>
      <button id="site-spark-drafts" type="button" class="site-spark-drafts-toggle">
        <i class="fa-solid fa-lock" aria-hidden="true"></i>
        {% if current_lang == 'en' %}Private drafts{% else %}私密草稿{% endif %}
      </button>
    </div>
    <span>
      {% if current_lang == 'en' -%}
        New entries are hidden from the site by default; repository source is public.
      {%- else -%}
        新内容默认不在网站公开；仓库源文件仍是公开的。
      {%- endif %}
    </span>
  </div>
  <section id="site-spark-drafts-panel" class="site-spark-drafts-panel" hidden aria-labelledby="site-spark-drafts-heading">
    <header>
      <div>
        <p>
          {% if current_lang == 'en' %}OWNER WORKSPACE{% else %}站长工作区{% endif %}
        </p>
        <h2 id="site-spark-drafts-heading">
          {% if current_lang == 'en' %}Private drafts{% else %}私密草稿{% endif %}
        </h2>
      </div>
      <button
        id="site-spark-drafts-close"
        class="site-spark-writer__icon-button"
        type="button"
        title="{% if current_lang == 'en' %}Close private drafts{% else %}关闭私密草稿{% endif %}"
        aria-label="{% if current_lang == 'en' %}Close private drafts{% else %}关闭私密草稿{% endif %}"
      >
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
    </header>
    <p id="site-spark-drafts-status" role="status" aria-live="polite"></p>
    <ul id="site-spark-drafts-list"></ul>
  </section>
  {% include spark-writer.liquid mode='create' %}
  <noscript>
    <style>
      #site-spark-create,
      #site-spark-drafts,
      .site-spark-edit-trigger {
        display: none;
      }
    </style>
  </noscript>
{% endif %}
<ul class="post-list">
  {% for post in localized_posts %}
    {% assign show_post = false %}
    {% if page.kinds %}
      {% if page.kinds contains post.kind %}
        {% assign show_post = true %}
      {% endif %}
    {% elsif post.kind == page.kind %}
      {% assign show_post = true %}
    {% endif %}

    {% if show_post %}
      {% assign visible_post_count = visible_post_count | plus: 1 %}
      {% if post.external_source == blank %}
        {% assign read_time = post.content | number_of_words | divided_by: 180 | plus: 1 %}
      {% else %}
        {% assign read_time = post.feed_content | strip_html | number_of_words | divided_by: 180 | plus: 1 %}
      {% endif %}
      <li>
        <div class="site-spark-list-heading">
          <h3>
            {% if post.redirect == blank %}
              <a class="post-title" href="{{ post.url | relative_url }}">{{ post.title }}</a>
            {% elsif post.redirect contains '://' %}
              <a class="post-title" href="{{ post.redirect }}" target="_blank" rel="noopener noreferrer">{{ post.title }}</a>
              <svg width="2rem" height="2rem" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path
                  d="M17 13.5v6H5v-12h6m3-3h6v6m0-6-9 9"
                  class="icon_svg-stroke"
                  stroke="#999"
                  stroke-width="1.5"
                  fill="none"
                  fill-rule="evenodd"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ></path>
              </svg>
            {% else %}
              <a class="post-title" href="{{ post.redirect | relative_url }}">{{ post.title }}</a>
            {% endif %}
          </h3>
          {% if page.translation_key == 'spark' %}
            {% assign spark_translations = site.posts | where: 'translation_key', post.translation_key %}
            {% assign spark_zh_post = spark_translations | where: 'lang', 'zh' | first %}
            {% assign spark_en_post = spark_translations | where: 'lang', 'en' | first %}
            <button
              class="site-spark-edit-trigger"
              type="button"
              title="{% if current_lang == 'en' %}Edit in place{% else %}原位编辑{% endif %}"
              aria-label="{% if current_lang == 'en' %}Edit {{ post.title }} in place{% else %}原位编辑《{{ post.title }}》{% endif %}"
              data-spark-edit
              data-translation-key="{{ post.translation_key | escape }}"
              data-source-path-zh="{{ spark_zh_post.path | escape }}"
              data-source-path-en="{{ spark_en_post.path | escape }}"
            >
              <i class="fa-solid fa-pen" aria-hidden="true"></i>
            </button>
          {% endif %}
        </div>
        <p>{{ post.description }}</p>
        <p class="post-meta">
          {{ read_time }}
          {% if current_lang == 'en' %}min read{% else %}分钟阅读{% endif %}
          &nbsp; · &nbsp; {{ post.date | date: '%Y-%m-%d' }}
          {% if post.external_source %}
            &nbsp; · &nbsp; {{ post.external_source }}
          {% endif %}
        </p>
      </li>
    {% endif %}
  {% endfor %}
  {% if visible_post_count == 0 %}
    <li>
      <p>{{ page.empty_text }}</p>
    </li>
  {% endif %}
</ul>
