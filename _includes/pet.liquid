{%- comment -%}
  网站宠物 ƒ-01：只输出一小段配置和一个 defer 的加载器，形象、样式和逻辑都在页面空闲后才加载。
  大脑地址（pet-brain/ 部署后的 Worker）为空时，宠物只用本地台词和站内搜索回答。
{%- endcomment -%}
{%- if site.pet -%}
  {%- capture pet_lines_url -%}{{ '/assets/pet/lines.json' | relative_url }}?v={{ site.time | date: '%s' }}{%- endcapture -%}
  <script type="application/json" id="functionhx-pet-config">
    {
      "enabled": {{ site.pet.enabled | default: false | jsonify }},
      "endpoint": {{ site.pet.endpoint | default: '' | jsonify }},
      "script": {{ '/assets/js/pet.js' | relative_url | bust_file_cache | jsonify }},
      "style": {{ '/assets/css/pet.css' | relative_url | bust_file_cache | jsonify }},
      "lines": {{ pet_lines_url | jsonify }},
      "sprites": {{ site.data.pet.sprites | jsonify }}
    }
  </script>
  <script src="{{ '/assets/js/pet-loader.js' | relative_url | bust_file_cache }}" defer></script>
{%- endif -%}
