<link rel="stylesheet" href="{{ '/assets/css/owner-ui.css' | relative_url | bust_file_cache }}">
<script>
  (() => {
    try {
      const hintKey = 'functionhx:owner-ui:vault-hint';
      const legacyRemembered = window.localStorage.getItem('functionhx:owner-ui:remembered') === 'true';
      const hasVaultHint = window.localStorage.getItem(hintKey) === 'true';
      if (legacyRemembered || hasVaultHint) {
        window.localStorage.setItem(hintKey, 'true');
        document.documentElement.dataset.ownerRestore = 'true';
      }
      window.localStorage.removeItem('functionhx:owner-ui:remembered');
      window.sessionStorage.removeItem('functionhx:owner-ui:session');
    } catch (_error) {
      // Browsing still works when storage is unavailable; owner controls stay hidden.
    }
  })();
</script>
