{% assign current_lang = page.lang | default: 'zh' %}
{% assign home_page = site.pages | where: 'home', true | where: 'lang', current_lang | first %}
{% assign search_page = site.pages | where: 'translation_key', 'search' | where: 'lang', current_lang | first %}
{% assign author_context = 'page' %}
{% if page.home %}
  {% assign author_context = 'home' %}
{% elsif page.translation_key == 'blog' %}
  {% assign author_context = 'blog' %}
{% elsif page.translation_key == 'tools' %}
  {% assign author_context = 'tools' %}
{% elsif page.translation_key == 'documents' %}
  {% assign author_context = 'documents' %}
{% elsif page.translation_key == 'projects' %}
  {% assign author_context = 'projects' %}
{% elsif page.translation_key == 'spark' %}
  {% assign author_context = 'spark' %}
{% elsif page.translation_key == 'news' %}
  {% assign author_context = 'news' %}
{% elsif page.path contains '_posts/' %}
  {% if page.kind == 'note' or page.kind == 'log' %}
    {% assign author_context = 'spark-entry' %}
  {% else %}
    {% assign author_context = 'article-entry' %}
  {% endif %}
{% elsif page.path contains '_projects/' %}
  {% if page.kind == 'tool' %}
    {% assign author_context = 'tool-entry' %}
  {% else %}
    {% assign author_context = 'project-entry' %}
  {% endif %}
{% elsif page.path contains '_news/' %}
  {% assign author_context = 'news-entry' %}
{% endif %}
{% if current_lang == 'en' %}
  {% assign navigation_label = 'Toggle navigation' %}
  {% assign search_title = 'Search' %}
  {% assign search_label = 'Open search' %}
  {% assign settings_title = 'Site settings' %}
  {% assign settings_label = 'Manage navigation and create sections' %}
  {% assign editor_title = 'Create and edit' %}
  {% assign editor_label = 'Open the owner writing menu' %}
  {% assign theme_title = 'Change theme · hold for Turbo' %}
  {% assign theme_label = 'Click to change color theme; press and hold to toggle Turbo mode' %}
  {% assign turbo_hint = 'Hold for Turbo' %}
{% else %}
  {% assign navigation_label = '展开导航' %}
  {% assign search_title = '搜索' %}
  {% assign search_label = '打开搜索' %}
  {% assign settings_title = '站点设置' %}
  {% assign settings_label = '打开站点设置' %}
  {% assign editor_title = '创作与编辑' %}
  {% assign editor_label = '打开站长创作菜单' %}
  {% assign theme_title = '切换主题 · 长按启动 Turbo' %}
  {% assign theme_label = '点击切换日间或夜间主题，长按启动或关闭 Turbo 模式' %}
  {% assign turbo_hint = '长按 Turbo' %}
{% endif %}

<style>
  :root {
    --site-nav-measure: min(72vw, 62rem);
    --site-nav-gap: clamp(0.2rem, 0.65vw, 0.8rem);
    --site-nav-link-padding: clamp(0.2rem, 0.4vw, 0.45rem);
  }

  html[data-nav-density='compact'] {
    --site-nav-measure: min(68vw, 50rem);
    --site-nav-gap: clamp(0.05rem, 0.35vw, 0.35rem);
    --site-nav-link-padding: clamp(0.08rem, 0.2vw, 0.22rem);
  }

  html[data-nav-density='relaxed'] {
    --site-nav-measure: min(82vw, 72rem);
    --site-nav-gap: clamp(0.45rem, 1vw, 1.15rem);
    --site-nav-link-padding: clamp(0.35rem, 0.55vw, 0.6rem);
  }

  #navbar .navbar-menu-list .nav-item.active > .nav-link {
    font-weight: inherit;
  }

  #site-settings-toggle {
    appearance: none;
    background: transparent;
    border: 0;
    color: inherit;
    cursor: pointer;
    font: inherit;
    margin: 0;
    padding: 0;
  }

  #site-settings-toggle .nav-link {
    display: block;
  }

  @media (min-width: 992px) {
    #navbar .navbar-container {
      width: calc(100% - 2rem);
      max-width: 1320px;
    }

    #navbar .navbar-container-home {
      justify-content: center;
    }

    #navbar .navbar-container-home .navbar-collapse-main {
      flex: 1 1 var(--site-nav-measure);
      max-width: var(--site-nav-measure);
      min-width: 0;
      width: 100%;
    }

    #navbar .navbar-container-home .navbar-menu-list {
      column-gap: var(--site-nav-gap);
      justify-content: space-between;
      margin-left: 0;
      width: 100%;
    }

    #navbar .navbar-menu-list > .nav-item,
    #navbar .navbar-menu-list > .toggle-container {
      flex: 0 0 auto;
    }

    #navbar .navbar-menu-list .nav-link {
      padding-right: var(--site-nav-link-padding);
      padding-left: var(--site-nav-link-padding);
    }
  }

  @media (min-width: 992px) and (max-width: 1199.98px) {
    #navbar .navbar-menu-list > .nav-item > .nav-link {
      font-size: 0.85rem;
    }

    #navbar #search-toggle .nav-link {
      white-space: nowrap;
    }
  }

  @media (min-width: 576px) and (max-width: 991.98px) {
    #navbar.navbar-expand-sm > .navbar-container {
      padding-right: 0;
      padding-left: 0;
    }

    #navbar.navbar-expand-sm .navbar-toggler-main {
      display: block;
      margin-left: auto;
    }

    #navbar.navbar-expand-sm .navbar-collapse-main {
      flex-basis: 100%;
      width: 100%;
      text-align: left;
    }

    #navbar.navbar-expand-sm .navbar-menu-list {
      align-items: flex-start;
      flex-direction: column;
      width: 100%;
      margin-left: 0;
    }

    #navbar.navbar-expand-sm .navbar-menu-list .nav-link {
      padding-right: 0;
      padding-left: 0;
    }
  }

  @layer components {
    @media (min-width: 576px) and (max-width: 991.98px) {
      #navbar.navbar-expand-sm .navbar-collapse-main {
        display: none !important;
      }

      #navbar.navbar-expand-sm .navbar-collapse-main.show {
        display: block !important;
      }
    }
  }
</style>

<noscript data-navigation-fallback>
  <style>
    @layer components {
      @media (max-width: 991.98px) {
        body.fixed-top-nav {
          padding-top: 0;
        }

        #navbar.navbar-expand-sm {
          position: static !important;
        }

        #navbar.navbar-expand-sm .navbar-toggler-main,
        #navbar.navbar-expand-sm .toggle-container {
          display: none !important;
        }

        #navbar.navbar-expand-sm .navbar-collapse-main {
          display: block !important;
          flex-basis: 100%;
          width: 100%;
        }

        #navbar.navbar-expand-sm .navbar-menu-list {
          align-items: flex-start;
          flex-direction: column;
          margin-left: 0;
          width: 100%;
        }

        #navbar.navbar-expand-sm .navbar-menu-list .nav-link {
          padding-right: 0;
          padding-left: 0;
        }

        #navbar.navbar-expand-sm .dropdown-menu {
          border: 0;
          box-shadow: none;
          display: block !important;
          float: none;
          padding: 0.1rem 0 0.5rem 1rem;
          position: static;
        }
      }
    }
  </style>
</noscript>

<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container navbar-container navbar-container-home navbar-container-stable">
      {% if current_lang != 'en' %}
        <a class="function-mobile-brand" href="{{ home_page.url | relative_url }}" aria-label="Function 首页"
          ><span aria-hidden="true">ƒ</span> Function</a
        >
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed navbar-toggler-main"
        type="button"
        data-nav-toggle="navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="{{ navigation_label }}"
      >
        <span class="sr-only">{{ navigation_label }}</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse navbar-collapse-main" id="navbarNav">
        <ul class="navbar-nav navbar-menu-list flex-nowrap">
          <!-- About -->
          <li class="nav-item {% if page.home %}active{% endif %}">
            <a class="nav-link" href="{{ home_page.url | relative_url }}" data-nav-translation-key="home">
              {% if current_lang != 'en' %}
                <span class="function-wordmark"><span aria-hidden="true">ƒ</span> Function</span>
              {% else %}
                {{- home_page.title }}
              {% endif %}
              {% if page.home %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% assign active_direct_key = '' %}
          {% for nav_page in sorted_pages %}
            {% if nav_page.nav and nav_page.dropdown != true and nav_page.autogen == null and nav_page.lang == current_lang %}
              {% assign direct_prefix = nav_page.permalink | remove: 'index.html' %}
              {% if direct_prefix != '' and page.url contains direct_prefix %}
                {% assign active_direct_key = nav_page.translation_key %}
              {% endif %}
            {% endif %}
          {% endfor %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null and p.lang == current_lang %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if active_direct_key == '' %}
                    {% if page.title == child.title or page.url contains child.permalink %}
                      {% assign has_active_child = true %}
                    {% endif %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="{{ p.url | relative_url }}"
                    id="navbarDropdown-{{ p.translation_key | escape }}"
                    role="button"
                    data-nav-translation-key="{{ p.translation_key | escape }}"
                    data-nav-dropdown-toggle="true"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {% if current_lang != 'en' %}
                      {{- p.title -}}
                      {%- include function-icon.liquid name='chevron' %}
                    {% elsif p.translation_key == 'more' %}
                      <i class="fa-solid fa-ellipsis" aria-hidden="true"></i>
                      <span class="sr-only">{{ p.title }}</span>
                    {% else %}
                      {{- p.title }}
                    {% endif %}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown-{{ p.translation_key | escape }}">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title or page.url contains child.permalink %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                          {% if current_lang != 'en' -%}
                            <span class="function-menu-arrow" aria-hidden="true">↗</span>
                          {%- endif %}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {% if p.permalink contains '://' %}
                    {% assign nav_url = p.permalink %}
                  {% else %}
                    {% assign nav_url = p.url %}
                  {% endif %}
                  <a class="nav-link" href="{{ nav_url | relative_url }}" data-nav-translation-key="{{ p.translation_key | escape }}">
                    {{- p.title }}
                    {% if page.url contains p.url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if current_lang != 'en' %}
            {% include function-nav-tools.liquid %}
          {% else %}
            <li class="nav-item">
              <button
                id="site-settings-toggle"
                type="button"
                title="{{ settings_title }}"
                aria-label="{{ settings_label }}"
                aria-controls="site-settings-dialog"
                aria-expanded="false"
              >
                <span class="nav-link">
                  <i class="fa-solid fa-gear" aria-hidden="true"></i>
                  <span class="sr-only">{{ settings_title }}</span>
                </span>
              </button>
              <noscript>
                <style>
                  #site-settings-toggle {
                    display: none;
                  }
                </style>
              </noscript>
            </li>
            {% if site.search_enabled %}
              <!-- Search -->
              <li class="nav-item">
                <a
                  id="search-toggle"
                  href="{{ search_page.url | default: '/search/' | relative_url }}"
                  title="{{ search_title }}"
                  aria-label="{{ search_label }}"
                  aria-haspopup="dialog"
                  aria-controls="magic-search-dialog"
                >
                  <span class="nav-link"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></span>
                </a>
              </li>
            {% endif %}
            {% if site.enable_darkmode %}
              <!-- Toggle theme mode -->
              <li class="toggle-container">
                <button
                  id="light-toggle"
                  type="button"
                  title="{{ theme_title }}"
                  aria-label="{{ theme_label }}"
                  aria-keyshortcuts="Shift+T"
                  data-turbo-trigger
                >
                  <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                  <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                  <i class="fa-solid fa-sun" id="light-toggle-light"></i>
                  <span class="turbo-trigger-hint" aria-hidden="true">{{ turbo_hint }}</span>
                </button>
              </li>
            {% endif %}
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if editor_source_path and current_lang != 'en' %}
    <div class="site-author-nav owner-only-control" data-page-author-tools>
      <button
        id="site-inline-editor-toggle"
        type="button"
        title="{{ editor_title }}"
        aria-label="{{ editor_label }}"
        aria-describedby="site-inline-editor-drag-hint"
        aria-controls="site-author-menu"
        aria-expanded="false"
        aria-pressed="false"
        data-author-context="{{ author_context }}"
      >
        {% include function-icon.liquid name='edit' %}
        <span class="sr-only">{{ editor_title }}</span>
        <span id="site-inline-editor-drag-hint" class="sr-only"
          >可拖动并记住位置；也可按 Shift 加方向键移动，按 Shift 加 Home 恢复右上角；点按打开创作菜单</span
        >
      </button>
      <div id="site-author-menu" class="site-author-menu" role="menu" hidden>
        <p>创作</p>
        {% if author_context == 'home' %}
          <button type="button" role="menuitem" data-author-action="article-create">
            <i class="fa-regular fa-file-lines" aria-hidden="true"></i><span>新建文章</span>
          </button>
          <a href="{{ '/spark/?compose=1' | relative_url }}" role="menuitem">
            <i class="fa-solid fa-bolt" aria-hidden="true"></i><span>新建 Spark</span>
          </a>
          <button type="button" role="menuitem" data-author-action="tool-create">
            <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i><span>新建工具</span>
          </button>
          <button type="button" role="menuitem" data-author-action="activity-create">
            <i class="fa-regular fa-bell" aria-hidden="true"></i><span>新增动态</span>
          </button>
        {% elsif author_context == 'blog' or author_context == 'article-entry' %}
          <button type="button" role="menuitem" data-author-action="article-create">
            <i class="fa-regular fa-file-lines" aria-hidden="true"></i><span>新建文章</span>
          </button>
        {% elsif author_context == 'tools' or author_context == 'tool-entry' %}
          <button type="button" role="menuitem" data-author-action="tool-create">
            <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i><span>新建工具</span>
          </button>
        {% elsif author_context == 'documents' %}
          <button type="button" role="menuitem" data-author-action="feishu-document-create">
            <i class="fa-regular fa-file-lines" aria-hidden="true"></i><span>新建飞书云文档</span>
          </button>
        {% elsif author_context == 'projects' or author_context == 'project-entry' %}
          <button type="button" role="menuitem" data-author-action="project-create">
            <i class="fa-solid fa-diagram-project" aria-hidden="true"></i><span>新建项目</span>
          </button>
        {% elsif author_context == 'spark' or author_context == 'spark-entry' %}
          <button type="button" role="menuitem" data-author-action="spark-create">
            <i class="fa-solid fa-bolt" aria-hidden="true"></i><span>新建 Spark</span>
          </button>
          <button type="button" role="menuitem" data-author-action="spark-drafts">
            <i class="fa-solid fa-lock" aria-hidden="true"></i><span>私密草稿</span>
          </button>
        {% elsif author_context == 'news' or author_context == 'news-entry' %}
          <button type="button" role="menuitem" data-author-action="activity-create">
            <i class="fa-regular fa-bell" aria-hidden="true"></i><span>新增动态</span>
          </button>
        {% endif %}
        {% if author_context == 'spark-entry' %}
          {% assign spark_zh_page = translated_pages | where: 'lang', 'zh' | first %}
          {% assign spark_en_page = translated_pages | where: 'lang', 'en' | first %}
          <button
            type="button"
            role="menuitem"
            data-author-action="spark-edit"
            data-translation-key="{{ page.translation_key | escape }}"
            data-source-path-zh="{{ spark_zh_page.path | escape }}"
            data-source-path-en="{{ spark_en_page.path | escape }}"
          >
            <i class="fa-regular fa-pen-to-square" aria-hidden="true"></i><span>编辑当前 Spark</span>
          </button>
        {% elsif author_context != 'news' and author_context != 'documents' %}
          <button type="button" role="menuitem" data-author-action="source-edit">
            <i class="fa-regular fa-pen-to-square" aria-hidden="true"></i>
            <span>
              {% if author_context == 'article-entry' %}
                编辑当前文章
              {% elsif author_context == 'tool-entry' %}
                编辑当前工具
              {% elsif author_context == 'project-entry' %}
                编辑当前项目
              {% elsif author_context == 'news-entry' %}
                编辑当前动态
              {% elsif author_context == 'home' %}
                编辑首页介绍
              {% else %}
                编辑当前页面
              {% endif %}
            </span>
          </button>
        {% endif %}
        <button type="button" class="site-author-menu__exit" role="menuitem" data-owner-mode-exit>
          <i class="fa-solid fa-eye" aria-hidden="true"></i><span>返回访客模式</span>
        </button>
      </div>
      <noscript>
        <style>
          .site-author-nav {
            display: none !important;
          }
        </style>
      </noscript>
    </div>
  {% endif %}
  {% if site.enable_progressbar and current_lang == 'en' %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
