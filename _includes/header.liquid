{% assign current_lang = page.lang | default: 'zh' %}
{% assign home_page = site.pages | where: 'home', true | where: 'lang', current_lang | first %}
{% assign translation_pool = site.pages
  | concat: site.projects
  | concat: site.posts
  | concat: site.news
  | concat: site.teachings
  | concat: site.books
%}
{% assign translated_pages = translation_pool | where: 'translation_key', page.translation_key %}
{% assign editor_action = 'source-edit' %}
{% assign editor_controls = 'site-inline-editor' %}
{% if page.translation_key == 'spark' %}
  {% assign editor_action = 'spark-create' %}
  {% assign editor_controls = 'site-spark-writer' %}
{% elsif page.path contains '_posts/' %}
  {% if page.kind == 'note' or page.kind == 'log' %}
    {% assign editor_action = 'spark-edit' %}
    {% assign editor_controls = 'site-spark-writer' %}
  {% endif %}
{% endif %}
{% if current_lang == 'en' %}
  {% assign target_lang = 'zh' %}
  {% assign language_label = '中' %}
  {% assign navigation_label = 'Toggle navigation' %}
  {% assign search_title = 'Search' %}
  {% assign search_label = 'Open search' %}
  {% assign settings_title = 'Site settings' %}
  {% assign settings_label = 'Manage navigation and create sections' %}
  {% assign editor_title = 'Edit this page' %}
  {% assign editor_label = 'Edit this page without leaving the site' %}
  {% assign theme_title = 'Change theme' %}
  {% assign theme_label = 'Change color theme' %}
{% else %}
  {% assign target_lang = 'en' %}
  {% assign language_label = 'EN' %}
  {% assign navigation_label = '展开导航' %}
  {% assign search_title = '搜索' %}
  {% assign search_label = '打开搜索' %}
  {% assign settings_title = '站点设置' %}
  {% assign settings_label = '管理栏目并新建栏目' %}
  {% assign editor_title = '即时编辑' %}
  {% assign editor_label = '不离开本站，直接编辑当前页面' %}
  {% assign theme_title = '切换主题' %}
  {% assign theme_label = '切换日间或夜间主题' %}
{% endif %}
{% if editor_action == 'spark-create' %}
  {% if current_lang == 'en' %}
    {% assign editor_title = 'New Spark' %}
    {% assign editor_label = 'Write a new Spark entry here' %}
  {% else %}
    {% assign editor_title = '新建闪耀' %}
    {% assign editor_label = '直接在这里写一条新的闪耀' %}
  {% endif %}
{% elsif editor_action == 'spark-edit' %}
  {% if current_lang == 'en' %}
    {% assign editor_title = 'Edit this Spark' %}
    {% assign editor_label = 'Edit this Spark entry in place' %}
  {% else %}
    {% assign editor_title = '编辑这条闪耀' %}
    {% assign editor_label = '在原处直接编辑这条闪耀' %}
  {% endif %}
{% endif %}
{% assign language_page = translated_pages | where: 'lang', target_lang | first %}
{% unless language_page %}
  {% assign language_page = site.pages | where: 'home', true | where: 'lang', target_lang | first %}
{% endunless %}

<style>
  :root {
    --site-nav-measure: min(72vw, 62rem);
    --site-nav-gap: clamp(0.2rem, 0.65vw, 0.8rem);
    --site-nav-link-padding: clamp(0.2rem, 0.4vw, 0.45rem);
  }

  html[data-nav-density='compact'] {
    --site-nav-measure: min(68vw, 50rem);
    --site-nav-gap: clamp(0.05rem, 0.35vw, 0.35rem);
    --site-nav-link-padding: clamp(0.08rem, 0.2vw, 0.22rem);
  }

  html[data-nav-density='relaxed'] {
    --site-nav-measure: min(82vw, 72rem);
    --site-nav-gap: clamp(0.45rem, 1vw, 1.15rem);
    --site-nav-link-padding: clamp(0.35rem, 0.55vw, 0.6rem);
  }

  #navbar .navbar-menu-list .nav-item.active > .nav-link {
    font-weight: inherit;
  }

  #site-settings-toggle,
  #site-inline-editor-toggle {
    appearance: none;
    background: transparent;
    border: 0;
    color: inherit;
    cursor: pointer;
    font: inherit;
    margin: 0;
    padding: 0;
  }

  #site-settings-toggle .nav-link,
  #site-inline-editor-toggle .nav-link {
    display: block;
  }

  @media (min-width: 992px) {
    #navbar .navbar-container {
      width: calc(100% - 2rem);
      max-width: 1320px;
    }

    #navbar .navbar-container-home {
      justify-content: center;
    }

    #navbar .navbar-container-home .navbar-collapse-main {
      flex: 1 1 var(--site-nav-measure);
      max-width: var(--site-nav-measure);
      min-width: 0;
      width: 100%;
    }

    #navbar .navbar-container-home .navbar-menu-list {
      column-gap: var(--site-nav-gap);
      justify-content: space-between;
      margin-left: 0;
      width: 100%;
    }

    #navbar .navbar-menu-list > .nav-item,
    #navbar .navbar-menu-list > .toggle-container {
      flex: 0 0 auto;
    }

    #navbar .navbar-menu-list .nav-link {
      padding-right: var(--site-nav-link-padding);
      padding-left: var(--site-nav-link-padding);
    }
  }

  @media (min-width: 992px) and (max-width: 1199.98px) {
    #navbar .navbar-menu-list > .nav-item > .nav-link {
      font-size: 0.85rem;
    }

    #navbar #search-toggle .nav-link {
      white-space: nowrap;
    }
  }

  @media (min-width: 576px) and (max-width: 991.98px) {
    #navbar.navbar-expand-sm > .navbar-container {
      padding-right: 0;
      padding-left: 0;
    }

    #navbar.navbar-expand-sm .navbar-toggler-main {
      display: block;
      margin-left: auto;
    }

    #navbar.navbar-expand-sm .navbar-collapse-main {
      flex-basis: 100%;
      width: 100%;
      text-align: left;
    }

    #navbar.navbar-expand-sm .navbar-menu-list {
      align-items: flex-start;
      flex-direction: column;
      width: 100%;
      margin-left: 0;
    }

    #navbar.navbar-expand-sm .navbar-menu-list .nav-link {
      padding-right: 0;
      padding-left: 0;
    }
  }

  @layer components {
    @media (min-width: 576px) and (max-width: 991.98px) {
      #navbar.navbar-expand-sm .navbar-collapse-main {
        display: none !important;
      }

      #navbar.navbar-expand-sm .navbar-collapse-main.show {
        display: block !important;
      }
    }
  }
</style>

<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container navbar-container navbar-container-home navbar-container-stable">
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed navbar-toggler-main"
        type="button"
        data-nav-toggle="navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="{{ navigation_label }}"
      >
        <span class="sr-only">{{ navigation_label }}</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse navbar-collapse-main" id="navbarNav">
        <ul class="navbar-nav navbar-menu-list flex-nowrap">
          <!-- About -->
          <li class="nav-item {% if page.home %}active{% endif %}">
            <a class="nav-link" href="{{ home_page.url | relative_url }}" data-nav-translation-key="home">
              {{- home_page.title }}
              {% if page.home %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null and p.lang == current_lang %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-nav-translation-key="{{ p.translation_key | escape }}"
                    data-nav-dropdown-toggle="true"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {% if p.permalink contains '://' %}
                    {% assign nav_url = p.permalink %}
                  {% else %}
                    {% assign nav_url = p.url %}
                  {% endif %}
                  <a class="nav-link" href="{{ nav_url | relative_url }}" data-nav-translation-key="{{ p.translation_key | escape }}">
                    {{- p.title }}
                    {% if page.url contains p.url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          <li class="nav-item">
            <a class="nav-link" href="{{ language_page.url | relative_url }}" lang="{% if target_lang == 'en' %}en{% else %}zh-CN{% endif %}">
              {{- language_label -}}
            </a>
          </li>
          <li class="nav-item">
            <button
              id="site-settings-toggle"
              type="button"
              title="{{ settings_title }}"
              aria-label="{{ settings_label }}"
              aria-controls="site-settings-dialog"
              aria-expanded="false"
            >
              <span class="nav-link">
                <i class="fa-solid fa-gear" aria-hidden="true"></i>
                <span class="sr-only">{{ settings_title }}</span>
              </span>
            </button>
            <noscript>
              <style>
                #site-settings-toggle {
                  display: none;
                }
              </style>
            </noscript>
          </li>
          {% if editor_source_path %}
            <li class="nav-item">
              <button
                id="site-inline-editor-toggle"
                type="button"
                title="{{ editor_title }}"
                aria-label="{{ editor_label }}"
                aria-controls="{{ editor_controls }}"
                aria-expanded="false"
                data-editor-action="{{ editor_action }}"
              >
                <span class="nav-link">
                  <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                  <span class="sr-only">{{ editor_title }}</span>
                </span>
              </button>
              <noscript>
                <style>
                  #site-inline-editor-toggle {
                    display: none;
                  }
                </style>
                {% if editor_action == 'spark-create' %}
                  <a
                    class="nav-link"
                    href="https://github.com/Functionhx/functionhx.github.io/tree/main/_posts"
                    title="{{ editor_title }}"
                    aria-label="{{ editor_label }}"
                  >
                    <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                  </a>
                {% else %}
                  <a
                    class="nav-link"
                    href="https://github.com/Functionhx/functionhx.github.io/edit/main/{{ editor_source_path }}"
                    title="{{ editor_title }}"
                    aria-label="{{ editor_label }}"
                  >
                    <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                  </a>
                {% endif %}
              </noscript>
            </li>
          {% endif %}
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" type="button" title="{{ search_title }}" aria-label="{{ search_label }}">
                <span class="nav-link">ctrl k <i class="fa-solid fa-magnifying-glass"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toggle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" type="button" title="{{ theme_title }}" aria-label="{{ theme_label }}">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
